            <rdf:Seq>
               <rdf:li>Laleh Abadi Marand</rdf:li>
               <rdf:li>Shohreh Noorizadeh Dehkordi</rdf:li>
               <rdf:li>Mahtab Roohi-Azizi</rdf:li>
               <rdf:li>Mehdi Dadgoo</rdf:li>
            </rdf:Seq>
         </dc:creator>
