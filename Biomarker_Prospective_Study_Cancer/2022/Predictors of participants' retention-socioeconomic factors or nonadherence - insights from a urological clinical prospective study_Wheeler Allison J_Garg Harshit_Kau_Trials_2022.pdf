               <rdf:li>Spasticity</rdf:li>
               <rdf:li>Exercises</rdf:li>
               <rdf:li>Dynamic neuromuscular stabilization</rdf:li>
               <rdf:li>Core stability</rdf:li>
            </rdf:Bag>
         </dc:subject>
         <dc:title>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">Effect of dynamic neuromuscular stabilization on balance and trunk function in people with multiple sclerosis: protocol for a randomized control trial</rdf:li>
            </rdf:Alt>
         </dc:title>
